extends "res://tests/d3_3_reference_book_test.gd"

## 在资源／贴纸专项之后单独运行，从磁盘恢复，不重建或补写夹具。
func _run() -> void:
	create_timer(90).timeout.connect(func(): push_error("资源贴纸独立恢复验证超时"); quit(1))
	root.size = Vector2i(1280, 720)
	root.gui_embed_subwindows = true
	shell = SHELL.instantiate()
	shell.run_slots.directory = REFERENCE_DIR
	var disks: Array[String] = []
	for index: int in 3: disks.append(FileAccess.get_file_as_string(shell.run_slots.get_slot_path(index)))
	root.add_child(shell)
	shell.apply_display_mode(shell.DisplayMode.WINDOW_720P)
	await frames()
	check(await shell.start_slot(0), "独立进程从磁盘恢复资源贴纸测试档")
	var before: Dictionary = shell.slot_progress.capture_state()
	await click(button("GalleryButton"))
	var gallery = await wait_gallery()
	await select_section(gallery, 1)
	var reference: Control = gallery._reference
	check(reference.entries.size() == 11 and reference.views.size() == 2 and reference._counter.text.contains("2 / 11"), "重启保留资源开放范围与独立发现计数")
	check(reference.views.any(func(view: CardView): return view.card_data.id == &"gear_scrap"), "重启保留已发现的衍生资源图鉴")
	check(not reference.views.any(func(view: CardView): return view.card_data.id == &"moondew"), "先前预览的月露重启后仍未揭晓")
	await select_section(gallery, 2)
	reference = gallery._reference
	check(reference.entries.size() == 34 and reference.page_count() == 2 and reference._counter.text.contains("3 / 70"), "重启保留贴纸开放、发现与分页")
	await choose_option(reference._category, 1)
	check(reference.entries.size() == 29, "重启伤势分区仍完整")
	var known: Array = reference._nodes.filter(func(node: Node): return node.name == "KnownSticker")
	check(known.size() == 1, "旧英文发现ID在重启后仍指向唯一已发现伤势")
	await click(known[0], MOUSE_BUTTON_RIGHT)
	check(is_instance_valid(reference._inspection), "重启后贴纸详情可正常打开")
	await key(KEY_ESCAPE)
	await frames()
	await choose_option(reference._category, 2)
	check(reference.entries.size() == 7, "重启保留七种元素贴纸资格")
	await select_section(gallery, 0)
	await choose_option(gallery._pack_filter, gallery._pack_ids.find(&"silvermoon_chapter"))
	await query(gallery, "观星者")
	check(gallery.views.has("stargazer:base"), "生成源永久发现随磁盘恢复")
	await click(gallery.views["stargazer:base"].get_node("ReadOnlyHoverHit"), MOUSE_BUTTON_RIGHT)
	await create_timer(0.7).timeout
	await click(gallery._inspection.find_child("DerivedPreviewButton", true, false))
	check(is_instance_valid(gallery._derived_preview) and gallery._derived_preview.views.size() == 2, "重启后仍可从生成源预览两种未生成预言")
	await key(KEY_ESCAPE)
	await frames()
	await key(KEY_ESCAPE)
	await wait_inspection_closed(gallery)
	await key(KEY_ESCAPE)
	while shell.screen_transition.busy: await process_frame
	check(not is_instance_valid(shell._gallery_panel) and shell._slot_progress_panel.visible, "重启后嵌套检视按层返回大厅")
	check(shell.slot_progress.capture_state() == before, "独立进程浏览不改写完整局外状态")
	for index: int in 3:
		check(FileAccess.get_file_as_string(shell.run_slots.get_slot_path(index)) == disks[index], "独立进程浏览不改写档位%d磁盘字节" % (index + 1))
	shell.return_to_start_menu()
	await frames()
	check(await shell.start_slot(1), "切换另一新档")
	await click(button("GalleryButton"))
	gallery = await wait_gallery()
	await select_section(gallery, 1)
	check(gallery._reference.entries.is_empty() and gallery._reference.views.is_empty() and gallery._reference._counter.text.contains("0 / 11"), "另一档资源未开放且未发现，不继承前档内容")
	await select_section(gallery, 2)
	check(gallery._reference.entries.is_empty() and gallery._reference._counter.text.contains("0 / 70"), "另一档未开放纹章隐藏，不继承前档贴纸")
	await choose_option(gallery._reference._category, 1)
	check(gallery._reference.entries.size() == 29 and gallery._reference._nodes.all(func(node: Node): return node.tooltip_text.is_empty() and node.find_children("*", "Label", true, false).is_empty() and node.get_child(0).material is ShaderMaterial), "另一档伤势只显示剪影，未借用已发现原图")
	check(shell.slot_progress.profile.discoveries.resources.is_empty() and shell.slot_progress.profile.discoveries.stickers.is_empty(), "切档后资源及贴纸发现仍独立")
	shell.free()
	await frames()
	print("D3-3 reference restore checks: %d, failures: %d" % [checks, failures])
	quit(1 if failures else 0)
