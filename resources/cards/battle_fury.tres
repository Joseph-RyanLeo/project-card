[ext_resource type="Texture2D" path="res://assets/card_art/spells/layers/battle_fury_middle_fire.png" id="layer_middle_fire"]

[resource]
script = ExtResource("1_card_data")
id = &"battle_fury"
display_name = "战斗怒火"
pack_id = &"ash_ledger"
effect_ids = Array[StringName]([&"battle_fury.effect.01"])
keywords = Array[StringName]([&"条件释放", &"无法被消灭", &"生命下限", &"持续时间"])
card_type = 2
rarity = 3
spell_type = 3
spell_trigger_kind = 2
background_texture = ExtResource("3_background")
background_offsets = Dictionary[int, Vector2i]({
3: Vector2i(0, -20)
})
background_overframe_offsets = Dictionary[int, Vector2i]({
0: Vector2i(1, -2),
3: Vector2i(0, 1)
})
art_texture = ExtResource("2_art")
inspection_art_layers = Array[Texture2D]([ExtResource("layer_back_fire"), ExtResource("layer_helmet"), ExtResource("layer_middle_fire"), ExtResource("layer_front_fire")])
inspection_art_layer_names = PackedStringArray("背景火焰", "头盔", "次前景火焰", "最前景火焰")
inspection_art_depths = Dictionary[StringName, float]({
&"background": 2.68,
&"res://assets/card_art/spells/layers/battle_fury_back_fire.png": 2.03
})
art_offset = Vector2i(1, 14)
effect_text = "触发：友方即将被消灭。友军5秒内生命最低为1。"
