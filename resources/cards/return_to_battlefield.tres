[ext_resource type="Texture2D" path="res://assets/card_art/spells/layers/return_to_battlefield_figures.png" id="layer_figures"]

[resource]
script = ExtResource("1_card_data")
id = &"return_to_battlefield"
display_name = "重返战场"
pack_id = &"ash_ledger"
effect_ids = Array[StringName]([&"return_to_battlefield.effect.01"])
keywords = Array[StringName]([&"延时释放", &"重新入场", &"最近死亡", &"非衍生", &"不重触突击"])
card_type = 2
rarity = 1
spell_type = 1
spell_trigger_kind = 3
spell_preparation_seconds = 10.0
background_texture = ExtResource("3_background")
background_offsets = Dictionary[int, Vector2i]({
3: Vector2i(0, -20)
})
background_overframe_offsets = Dictionary[int, Vector2i]({
0: Vector2i(0, -3),
3: Vector2i(0, 1)
})
art_texture = ExtResource("2_art")
inspection_art_layers = Array[Texture2D]([ExtResource("layer_figures")])
inspection_art_layer_names = PackedStringArray("复生者")
art_offset = Vector2i(0, 13)
effect_text = "准备10秒：最近被消灭的非衍生友军以50%生命重新入场。"
